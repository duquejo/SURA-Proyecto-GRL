        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n  title Diagrama de Contenedores - Plataforma Control Presupuestal ARL\n\n  Person(prof, \&quot;Profesional de Prevención\&quot;, \&quot;Planea órdenes y consulta saldos\&quot;)\n  Person(prest, \&quot;Prestador de Servicios\&quot;, \&quot;Ejecuta y cierra órdenes en campo\&quot;)\n  Person(lider, \&quot;Líder de Prevención\&quot;, \&quot;Supervisa ejecución por grupo\&quot;)\n\n  System_Boundary(b1, \&quot;Plataforma Control Presupuestal ARL (Azure Cloud)\&quot;) {\n    Container(spa, \&quot;Aplicación Web SPA\&quot;, \&quot;Angular Standalone, Signal Store\&quot;, \&quot;Interfaz para planeación, gestión de órdenes y tableros por grupo (1001-arl-manager_fe).\&quot;)\n    Container(api, \&quot;Microservicio Control Presupuestal\&quot;, \&quot;Java 21, Spring WebFlux\&quot;, \&quot;Expone API REST reactiva, aplica reglas RN-01..10 e idempotencia (1000-arl-manager_ms).\&quot;)\n    ContainerDb(db, \&quot;Base de Datos Presupuestal\&quot;, \&quot;Azure PostgreSQL 16\&quot;, \&quot;Almacena presupuestos, planes, órdenes, idempotencia y tabla outbox_eventos.\&quot;)\n    ContainerQueue(mq, \&quot;Broker de Mensajería\&quot;, \&quot;RabbitMQ\&quot;, \&quot;Distribuye eventos PresupuestoReservado, Consumido y Liberado (Reactive Commons).\&quot;)\n  }\n\n  System_Ext(idp, \&quot;Proveedor de Identidad\&quot;, \&quot;Entra ID / OAuth2\&quot;, \&quot;Autentica usuarios y emite tokens JWT.\&quot;)\n  System_Ext(catalogo, \&quot;Catálogo y Riesgo IA\&quot;, \&quot;APIs Corporativas\&quot;, \&quot;Provee tarifas vigentes y evaluación de riesgo final.\&quot;)\n  System_Ext(coreFin, \&quot;Core Financiero / ERP\&quot;, \&quot;Sistema Corporativo\&quot;, \&quot;Envía presupuesto inicial y recibe movimientos.\&quot;)\n\n  Rel(prof, spa, \&quot;Usa aplicación web\&quot;, \&quot;HTTPS\&quot;)\n  Rel(prest, spa, \&quot;Usa aplicación web\&quot;, \&quot;HTTPS\&quot;)\n  Rel(lider, spa, \&quot;Usa aplicación web\&quot;, \&quot;HTTPS\&quot;)\n\n  Rel(spa, idp, \&quot;Autentica usuario\&quot;, \&quot;OIDC / PKCE\&quot;)\n  Rel(spa, api, \&quot;Consume API\&quot;, \&quot;REST/JSON, JWT, X-Idempotency-Key\&quot;)\n\n  Rel(api, db, \&quot;Lee/escribe con SELECT FOR UPDATE\&quot;, \&quot;R2DBC / TLS\&quot;)\n  Rel(api, mq, \&quot;Publica eventos desde Outbox\&quot;, \&quot;AMQP / Reactive Commons\&quot;)\n  Rel(api, catalogo, \&quot;Consulta tarifas y nivel de riesgo\&quot;, \&quot;REST / HTTPS\&quot;)\n\n  Rel(coreFin, api, \&quot;Carga presupuesto anual\&quot;, \&quot;REST / HTTPS\&quot;)\n  Rel(mq, coreFin, \&quot;Entrega eventos financieros\&quot;, \&quot;AMQP\&quot;)\n\n  UpdateLayoutConfig($c4ShapeInRow=\&quot;3\&quot;, $c4BoundaryInRow=\&quot;1\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="XLYmIhTUFKhRrvKGfRx4-1">
