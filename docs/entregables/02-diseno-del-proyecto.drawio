  <diagram id="TJl5Zd0Z9eKH58Id04Fr" name="02.3-modelo-ddd">
    <mxGraphModel dx="3535" dy="1858" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
