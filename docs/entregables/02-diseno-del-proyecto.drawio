        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class GrupoPrevencion {\n    +UUID id\n    +String nombre\n    +UUID liderPrevencionId\n  }\n\n  class EmpresaAfiliada {\n    +UUID id\n    +String nit\n    +String razonSocial\n    +UUID grupoPrevencionId\n    +NivelRiesgo nivelRiesgoActual\n  }\n\n  class PresupuestoAnual {\n    +UUID id\n    +UUID empresaAfiliadaId\n    +int vigenciaAnual\n    +BigDecimal montoTotal\n    +BigDecimal saldoDisponible\n    +BigDecimal saldoComprometido\n    +BigDecimal saldoEjecutado\n    +asignarPresupuestoAnual(BigDecimal monto)\n    +comprometerSaldo(BigDecimal monto)\n    +ejecutarSaldo(BigDecimal monto)\n    +liberarSaldo(BigDecimal monto)\n  }\n\n  class PlanTrabajo {\n    +UUID id\n    +UUID empresaAfiliadaId\n    +UUID profesionalPrevencionId\n    +int vigenciaAnual\n    +EstadoPlan estado\n    +planearOrdenServicio(OrdenServicio orden)\n    +reajustarPlanTrabajo()\n  }\n\n  class OrdenServicio {\n    +UUID id\n    +UUID planTrabajoId\n    +UUID presupuestoId\n    +UUID prestadorId\n    +BigDecimal valorTotal\n    +EstadoOrden estado\n    +ejecutarOrdenServicio()\n    +cancelarOrdenServicio()\n  }\n\n  class ServicioPrevencion {\n    +UUID id\n    +String codigo\n    +String nombre\n    +BigDecimal tarifaPactada\n  }\n\n  class EvaluacionRiesgo {\n    +UUID id\n    +UUID ordenServicioId\n    +UUID profesionalPrevencionId\n    +NivelRiesgo nivelRiesgoInicial\n    +NivelRiesgo nivelRiesgoFinal\n    +boolean riesgoDisminuyo\n    +LocalDate fechaEvaluacion\n  }\n\n  class ContextoUsuario {\n    +UUID usuarioId\n    +RolUsuario rol\n    +UUID grupoPrevencionId\n  }\n\n  class EstadoOrden {\n    +PLANEADA\n    +EJECUTADA\n    +CANCELADA\n  }\n\n  class EstadoPlan {\n    +EN_PLANEACION\n    +EN_EJECUCION\n    +CERRADO\n  }\n\n  class RolUsuario {\n    +REPRESENTANTE_SST\n    +PRESTADOR\n    +PROFESIONAL_PREVENCION\n    +LIDER_PREVENCION\n  }\n\n  GrupoPrevencion \&quot;1\&quot; --&gt; \&quot;*\&quot; EmpresaAfiliada : supervisa\n  EmpresaAfiliada \&quot;1\&quot; --&gt; \&quot;*\&quot; PresupuestoAnual : tiene por vigencia\n  EmpresaAfiliada \&quot;1\&quot; --&gt; \&quot;*\&quot; PlanTrabajo : recibe\n  PlanTrabajo \&quot;1\&quot; *-- \&quot;*\&quot; OrdenServicio : contiene\n  OrdenServicio \&quot;1\&quot; *-- \&quot;1..*\&quot; ServicioPrevencion : agrupa\n  PresupuestoAnual \&quot;1\&quot; &lt;-- \&quot;*\&quot; OrdenServicio : bloquea y descuenta\n  OrdenServicio \&quot;1\&quot; --&gt; \&quot;0..1\&quot; EvaluacionRiesgo : evaluada mediante\n  OrdenServicio --&gt; EstadoOrden : estado\n  PlanTrabajo --&gt; EstadoPlan : estado\n  ContextoUsuario --&gt; RolUsuario : rol&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="y2cAj1aceqZ0LO21ZrMg-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
