  <diagram id="oLM2_iJsL1wKF6WQ7nL1" name="02.4-modelo-de-despliegue-nube">
    <mxGraphModel dx="4385" dy="1858" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Deployment\n  title Diagrama de Despliegue en Nube (Azure + Apigee X + Dynatrace) - Plataforma Control Presupuestal ARL\n\n  Deployment_Node(client, \&quot;Dispositivo del Usuario\&quot;, \&quot;Navegador Web (Chrome, Edge, Safari)\&quot;) {\n    Container(spaClient, \&quot;Aplicación Web SPA\&quot;, \&quot;Angular Standalone, NgRx Signal Store\&quot;, \&quot;Interfaz reactiva para los 4 roles operativos (1001-arl-manager_fe).\&quot;)\n  }\n\n  Deployment_Node(apigeeCloud, \&quot;Capa de API Management\&quot;, \&quot;Apigee X\&quot;) {\n    Container(apigee, \&quot;Apigee X API Gateway\&quot;, \&quot;OpenAPI 3.1 / TLS 1.3\&quot;, \&quot;Gobierna /api/*: valida JWT, aplica cuotas y políticas de seguridad hacia AKS.\&quot;)\n  }\n\n  Deployment_Node(azure, \&quot;Microsoft Azure Cloud\&quot;, \&quot;Suscripción Productiva (IaC: Terraform 1002-arl-manager_tf)\&quot;) {\n    Deployment_Node(swaNode, \&quot;Alojamiento Frontend\&quot;, \&quot;Azure Static Web Apps / CDN\&quot;) {\n      Container(spaHost, \&quot;Static Web App\&quot;, \&quot;HTML5, JS, CSS\&quot;, \&quot;Distribuye los artefactos estáticos compilados de 1001-arl-manager_fe.\&quot;)\n    }\n\n    Deployment_Node(vnet, \&quot;Azure Virtual Network (VNet)\&quot;, \&quot;Red Privada Aislada\&quot;) {\n      Deployment_Node(aks, \&quot;Azure Kubernetes Service (AKS)\&quot;, \&quot;Cluster Gestionado Kubernetes (SLA 99.5%)\&quot;) {\n        Container(ingress, \&quot;AKS Ingress Controller\&quot;, \&quot;Internal Load Balancer\&quot;, \&quot;Recibe tráfico HTTPS desde Apigee X y balancea hacia los pods del backend.\&quot;)\n        Container(apiPod, \&quot;Microservicio Control Presupuestal\&quot;, \&quot;Java 21, Spring Boot 3.3, WebFlux (HPA 250 usuarios)\&quot;, \&quot;Aplica RN-01..10, SELECT FOR UPDATE e idempotencia (1000-arl-manager_ms).\&quot;)\n        ContainerQueue(mqPod, \&quot;Broker de Mensajería\&quot;, \&quot;RabbitMQ (Reactive Commons)\&quot;, \&quot;Publica eventos PresupuestoReservado, Consumido y Liberado.\&quot;)\n        Container(dtAgent, \&quot;Dynatrace OneAgent\&quot;, \&quot;DaemonSet AKS\&quot;, \&quot;Monitorea rendimiento de pods WebFlux, consultas R2DBC y mensajería AMQP.\&quot;)\n      }\n\n      Deployment_Node(dataSubnet, \&quot;Subred Privada de Datos\&quot;, \&quot;Private Endpoint\&quot;) {\n        ContainerDb(pgDb, \&quot;Base de Datos Presupuestal\&quot;, \&quot;Azure Database for PostgreSQL 16 (Flexible Server)\&quot;, \&quot;Alta disponibilidad Zone-Redundant, respaldo automático, constraints CHECK y outbox.\&quot;)\n      }\n    }\n\n    Deployment_Node(ops, \&quot;Gobierno y Secretos Azure\&quot;, \&quot;Servicios PaaS Azure\&quot;) {\n      Container(kv, \&quot;Azure Key Vault\&quot;, \&quot;HSM / Secrets\&quot;, \&quot;Almacena cadenas R2DBC y credenciales RabbitMQ.\&quot;)\n      Container(acr, \&quot;Azure Container Registry (ACR)\&quot;, \&quot;Registro Privado Docker\&quot;, \&quot;Almacena las imágenes Docker del microservicio.\&quot;)\n    }\n  }\n\n  Deployment_Node(dtCloud, \&quot;Observabilidad APM\&quot;, \&quot;Dynatrace SaaS\&quot;) {\n    Container(dynatrace, \&quot;Dynatrace Platform\&quot;, \&quot;APM &amp; Kubernetes Monitoring\&quot;, \&quot;Consolida trazas distribuidas, métricas de pods y alertas de latencia (&lt; 2s).\&quot;)\n  }\n\n  Deployment_Node(extIdp, \&quot;Nube de Identidad Corporativa\&quot;, \&quot;Entra ID / OAuth2\&quot;) {\n    Container(idp, \&quot;Proveedor de Identidad (IdP)\&quot;, \&quot;OIDC / PKCE / JWT\&quot;, \&quot;Autentica usuarios y emite tokens con usuarioId, rol y grupoPrevencionId.\&quot;)\n  }\n\n  Deployment_Node(extAreas, \&quot;Ecosistema Plataforma ARL\&quot;, \&quot;Consumidores de Eventos\&quot;) {\n    Container(modulos, \&quot;Módulos de Planeación, Órdenes y Reportes\&quot;, \&quot;Consumidores AMQP\&quot;, \&quot;Reciben notificaciones en tiempo real sobre reservas, consumos y liberaciones.\&quot;)\n  }\n\n  Rel(spaClient, spaHost, \&quot;Descarga aplicación web\&quot;, \&quot;HTTPS\&quot;)\n  Rel(spaClient, idp, \&quot;Autentica usuario\&quot;, \&quot;OIDC / PKCE\&quot;)\n  Rel(spaClient, apigee, \&quot;Consume APIs /api/*\&quot;, \&quot;HTTPS, JWT, X-Idempotency-Key\&quot;)\n  Rel(apigee, ingress, \&quot;Enruta tráfico autorizado\&quot;, \&quot;HTTPS\&quot;)\n  Rel(ingress, apiPod, \&quot;Balancea peticiones\&quot;, \&quot;HTTP\&quot;)\n  Rel(apiPod, pgDb, \&quot;Opera saldos con SELECT FOR UPDATE\&quot;, \&quot;R2DBC / TLS\&quot;)\n  Rel(apiPod, mqPod, \&quot;Publica eventos desde Outbox\&quot;, \&quot;AMQP / Reactive Commons\&quot;)\n  Rel(kv, apiPod, \&quot;Inyecta secretos en pods\&quot;, \&quot;Secrets Store CSI Driver\&quot;)\n  Rel(aks, acr, \&quot;Descarga imágenes Docker\&quot;, \&quot;HTTPS\&quot;)\n  Rel(dtAgent, dynatrace, \&quot;Envía métricas y trazas reactivas\&quot;, \&quot;HTTPS / TLS\&quot;)\n  Rel(mqPod, modulos, \&quot;Entrega eventos de dominio\&quot;, \&quot;AMQP\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Rgu9pra9Yg9X0dD4q6Ek-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="Rgu9pra9Yg9X0dD4q6Ek-2" parent="Rgu9pra9Yg9X0dD4q6Ek-1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontColor=light-dark(#333333,#cccccc);align=left;verticalAlign=top;spacingLeft=703;" value="Diagrama de Despliegue en Nube (Azure + Apigee X + Dynatrace) - Plataforma Control Presupuestal ARL" vertex="1">
